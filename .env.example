# Copy this file to .env and fill in your keys. Never commit .env.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Hugging Face token (for model downloads)
HF_TOKEN=

# Modal proxy token for the Glimmer endpoint:
#   modal workspace proxy-tokens create --name glimmer
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
# (Modal's own login comes from `modal setup`; nothing needed here for that.)
